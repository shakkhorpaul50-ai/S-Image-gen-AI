@{
    ViewData["Title"] = "Home";
}
<div class="p-5 mb-4 bg-light rounded-3">
    <div class="container-fluid py-4">
        <h1 class="display-5 fw-bold">S-Image-gen-AI</h1>
        <p class="col-md-8 fs-5">Chat with our custom 0.15B diffusion model. Describe an image — or attach a photo to restyle it. Free: 50 generations per user per day.</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary btn-lg" asp-controller="Chat" asp-action="Index">Open chat</a>
        }
        else
        {
            <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Create free account</a>
            <a class="btn btn-outline-secondary btn-lg" asp-controller="Account" asp-action="Login">Login</a>
        }
    </div>
</div>
<div class="row">
    <div class="col-md-4"><h4>Tiny &amp; free</h4><p>Our own 0.15B model (~45MB weights, &lt;220MB runtime) — no GPU bills.</p></div>
    <div class="col-md-4"><h4>Continuous threads</h4><p>Every prompt continues the conversation; history, seeds and styles stay with the thread.</p></div>
    <div class="col-md-4"><h4>Fair use</h4><p>50 generations per user per day, tracked in Postgres, resetting at UTC midnight.</p></div>
</div>
