@model Generation
@{
    ViewData["Title"] = "Result";
}
<h2>Result</h2>
@if (Model.Status == "Done" && Model.ImageUrl != null)
{
    <img src="@Model.ImageUrl" alt="@Model.Prompt" class="img-fluid rounded mb-3" style="max-width:512px" />
    <p><a class="btn btn-success" href="@Model.ImageUrl" download target="_blank">Download</a></p>
}
else
{
    <div class="alert alert-warning">Status: @Model.Status@(Model.Error != null ? " — " + Model.Error : "")</div>
}
<dl class="row">
    <dt class="col-sm-2">Prompt</dt><dd class="col-sm-10">@Model.Prompt</dd>
    <dt class="col-sm-2">Mode</dt><dd class="col-sm-10">@Model.Mode</dd>
    <dt class="col-sm-2">Seed</dt><dd class="col-sm-10">@Model.Seed</dd>
    <dt class="col-sm-2">Model</dt><dd class="col-sm-10">@Model.Model (@Model.Size)</dd>
    <dt class="col-sm-2">Created</dt><dd class="col-sm-10">@Model.CreatedAtUtc.ToString("u")</dd>
</dl>
<a asp-action="Index" class="btn btn-primary">New image</a>
<a asp-controller="Gallery" asp-action="Index" class="btn btn-secondary">Gallery</a>
