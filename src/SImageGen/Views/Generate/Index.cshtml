@model GenerateVm
@{
    ViewData["Title"] = "Generate";
}
<h2>Generate image</h2>
<p class="text-muted">Used today: <strong>@ViewBag.Used / @ViewBag.Quota</strong> (resets UTC midnight)</p>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="col-md-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Mode" class="form-label">Mode</label>
        <select asp-for="Mode" class="form-select" id="modeSel">
            <option value="t2i">Text → image</option>
            <option value="i2i">Image → image (restyle)</option>
        </select>
    </div>
    <div class="mb-3" id="imgBox" style="display:none">
        <label asp-for="Image" class="form-label">Source image (max 5 MB)</label>
        <input asp-for="Image" type="file" accept="image/*" class="form-control" />
        <span asp-validation-for="Image" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Prompt" class="form-label">Prompt</label>
        <textarea asp-for="Prompt" class="form-control" rows="3" maxlength="500" placeholder="a cat, ukiyo-e woodblock print"></textarea>
        <span asp-validation-for="Prompt" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Seed" class="form-label">Seed (optional — blank = random, repeatable via gallery)</label>
        <input asp-for="Seed" type="number" min="0" class="form-control" />
        <span asp-validation-for="Seed" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">Generate</button>
</form>
@section Scripts {
<script>
    const sel = document.getElementById('modeSel'), box = document.getElementById('imgBox');
    const sync = () => box.style.display = sel.value === 'i2i' ? '' : 'none';
    sel.addEventListener('change', sync); sync();
</script>
}
