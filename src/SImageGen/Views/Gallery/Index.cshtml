@model List<Generation>
@{
    ViewData["Title"] = "My gallery";
}
<h2>My gallery</h2>
@if (Model.Count == 0)
{
    <p>No images yet. <a asp-controller="Generate" asp-action="Index">Generate your first one</a>.</p>
}
else
{
    <div class="row row-cols-2 row-cols-md-4 g-3">
        @foreach (var g in Model)
        {
            <div class="col">
                <div class="card h-100">
                    @if (g.Status == "Done" && g.ImageUrl != null)
                    {
                        <a asp-controller="Generate" asp-action="Result" asp-route-id="@g.Id">
                            <img src="@g.ImageUrl" class="card-img-top" alt="@g.Prompt" loading="lazy" />
                        </a>
                    }
                    else
                    {
                        <div class="card-body"><span class="badge bg-secondary">@g.Status</span></div>
                    }
                    <div class="card-body p-2">
                        <small class="text-muted">@g.Prompt (seed @g.Seed)</small>
                    </div>
                </div>
            </div>
        }
    </div>
}
